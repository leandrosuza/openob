# OpenOB Environment Configuration Template
# Copie este arquivo para .env e configure seus valores

# JWT - Chave secreta para assinatura de tokens (GERAR UMA CHAVE FORTE EM PRODUÇÃO)
JWT_SECRET_KEY=change-this-secret-key-in-production-use-python-secrets
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS - Origens permitidas (separadas por vírgula)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Rate Limiting (requisições por minuto)
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REFRESH=20/minute
RATE_LIMIT_HEALTH=100/minute
RATE_LIMIT_SUBSCRIPTION=10/minute
RATE_LIMIT_PAYMENT=5/minute

# Preços dos planos (em BRL)
PLAN_DAILY_PRICE=5.00
PLAN_WEEKLY_PRICE=25.00
PLAN_MONTHLY_PRICE=80.00

# Configurações de subscription
GRACE_PERIOD_DAYS=3
SUBSCRIPTION_CHECK_INTERVAL_HOURS=1

# Segurança de webhooks
WEBHOOK_SECRET=sua-secret-key-aqui-assinatura-hmac
WEBHOOK_TOLERANCE_SECONDS=300

# SSID para conexão de Payout (reconecta a cada 5s)
POCKETOPTION_PAYOUT_SSID=42["auth",{"session":"YOUR_SESSION_ID","isDemo":1,"uid":YOUR_UID,"platform":2,"isFastHistory":true,"isOptimized":true}]

# SSID para conexão de Monitoramento (preços/ticks)
POCKETOPTION_MONITOR_SSID=42["auth",{"session":"YOUR_SESSION_ID","isDemo":1,"uid":YOUR_UID,"platform":2,"isFastHistory":true,"isOptimized":true}]

# Número de ativos com melhor payout para monitorar automaticamente
MONITOR_TOP_ASSETS=3

# Nível de log: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Tipo de banco de dados: sqlite
DATABASE_TYPE=sqlite

# Caminho do banco de dados SQLite
SQLITE_PATH=data/openob.db
