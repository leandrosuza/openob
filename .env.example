# OpenOB Environment Configuration Template
# Copie este arquivo para .env e configure seus valores

# SSID para conexão de Payout (reconecta a cada 5s)
POCKETOPTION_PAYOUT_SSID=42["auth",{"session":"YOUR_SESSION_ID","isDemo":1,"uid":YOUR_UID,"platform":2,"isFastHistory":true,"isOptimized":true}]

# SSID para conexão de Monitoramento (preços/ticks)
POCKETOPTION_MONITOR_SSID=42["auth",{"session":"YOUR_SESSION_ID","isDemo":1,"uid":YOUR_UID,"platform":2,"isFastHistory":true,"isOptimized":true}]

# Número de ativos com melhor payout para monitorar automaticamente
MONITOR_TOP_ASSETS=8

# Nível de log: DEBUG, INFO, WARNING, ERROR, CRITICAL, FULL
LOG_LEVEL=INFO

# Tipo de banco de dados: sqlite
DATABASE_TYPE=sqlite

# Caminho do banco de dados SQLite
SQLITE_PATH=data/openob_ticks.db
